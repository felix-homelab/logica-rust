{
  "name": "logica-workspace",
  "private": true,
  "license": "Apache-2.0",
  "description": "npm workspace for the Logica window (packages/, apps/)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/run-workspaces.mjs build",
    "lint": "node scripts/run-workspaces.mjs lint",
    "test": "node scripts/run-workspaces.mjs test",
    "start": "npm run start -w apps/desktop",
    "package": "npm run build && npm run package -w apps/desktop",
    "test:e2e": "npm run test:e2e -w apps/desktop"
  }
}
