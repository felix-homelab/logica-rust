  "info": {
    "what": "Single data line for parts like the DS18B20 temperature sensor. Rests high.",
    "confirm": "Starts with a low pulse of about 480 µs, then a shorter low pulse from the device. After that, low pulses of two lengths in slots of 60 to 120 µs.",
    "decoderTips": "One channel. Short low pulse = 1, long low pulse = 0. Bit order LSB first.",
    "lookalikes": "DHT sensors and IR remotes also use two pulse lengths on one line; the timing tells them apart.",
    "symptoms": [
      {
        "symptom": "Reset but no presence pulse",
        "cause": "No device on the bus, or it is not powered",
        "action": "Check the 4.7 kΩ pull-up and the power pin (parasite power needs a strong pull-up)."
      },
      {
        "symptom": "Temperature reads 85 °C",
        "cause": "The DS18B20 power-on value: no conversion was finished",
        "action": "Wait 750 ms after Convert T before reading."
      }
    ]
